# 'sendmail', 'smtp' or 'smtp-tls'
MAIL_TYPE=sendmail
# info@bookings.example.com - Make sure 'bookings.example.com' matches the hosting domain when using type 'sendmail'
MAIL_ADDRESS=info@bookings.example.com
# for 'smtp' type only, otherwise remove or leave as is
MAIL_SMTP_HOST=?
# for 'smtp' type only, otherwise remove or leave as is
MAIL_SMTP_USER=?
# for 'smtp' type only, otherwise remove or leave as is
MAIL_SMTP_PW=?
# for 'smtp' type only, otherwise remove or leave as is
MAIL_SMTP_PORT=auto
# for 'smtp' type only, change this to 'login' if you have problems with SMTP authentication
MAIL_SMTP_AUTH=plain

# SSA iOS APNs push notifications.
# Required before enabling the DEBUG push test endpoint or scheduled push jobs.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_TOPIC=com.example.SSAApp
APNS_DEFAULT_ENV=development
# Prefer base64 in hosted environments to avoid multiline .p8 formatting issues.
APNS_KEY_P8_BASE64=
# Alternative raw .p8 content; supports escaped \n sequences.
APNS_KEY_P8=
# Enables POST /api/ssa/v1/push-test-booking-reminder.php for authenticated DEBUG app testing.
SSA_ENABLE_DEBUG_PUSH_ENDPOINT=false

# Base URL of the UKSA scoreboard app (no trailing slash).
# Used to build profilePhotoUrl in /api/ssa/v1/me.php.
# If unset, profilePhotoUrl is returned as null.
SSA_SCOREBOARD_BASE_URL=https://scoreboard-cfz3s.ondigitalocean.app
